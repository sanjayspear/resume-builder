# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.npm-cache

# generated by "postinstall" from node_modules/pdfjs-dist
/public/pdf.worker.min.mjs

# static export for GitHub Pages (built by CI)
/out/

# local npm cache workaround (see README "Troubleshooting"); not needed by others
.npmrc

# private reference material - never publish
/My resumes home.pdf
/reference-resume.png

# playwright
/test-results/
/playwright-report/

# spelling dictionaries, copied in by "postinstall"
/public/dictionaries/
